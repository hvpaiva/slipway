#!/usr/bin/env ruby
# frozen_string_literal: true

# The .TH date comes from the newest CHANGELOG.md release heading, not today, and stays empty
# until a version is released, so the output is reproducible.

require 'fileutils'
require 'slipway'
require_relative '../rakelib/support/changelog'

ROOT = File.expand_path('..', __dir__)
CHANGELOG = File.join(ROOT, 'CHANGELOG.md')

abort 'usage: bin/generate-man [DIRECTORY]' if ARGV.size > 1
output_dir = File.expand_path(ARGV.fetch(0, File.join(ROOT, 'man', 'man1')))
date = File.exist?(CHANGELOG) ? Changelog.release_date(File.read(CHANGELOG)).to_s : ''

registry = Slipway::Commands.registry(Slipway::Runtime.method(:build))
pages = Slipway::CLI::Manpage.new(registry, date:, configuration: Slipway::Config::DOCUMENTATION).pages

FileUtils.mkdir_p(output_dir)
FileUtils.rm_f(Dir[File.join(output_dir, '*.1')])
pages.each do |name, roff|
  File.write(File.join(output_dir, name), roff)
  puts "wrote #{File.join(output_dir, name).delete_prefix("#{ROOT}/")}"
end
